# ==============================================================================
# AI Personal OS — Master .gitignore
# Prevents sensitive keys, virtual environments, build artifacts, databases,
# system files, and dependencies from being committed to GitHub.
# ==============================================================================

# ─── Environment Variables & Secrets ──────────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
.env.*
!.env.example

# ─── Python & Virtual Environments ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Python Tools & Testing Caches ───────────────────────────────────────────
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ─── Databases & Data Storage ─────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
.langchain.db
backend/.langchain.db

# ─── Node.js & Frontend Build Artifacts ──────────────────────────────────────
node_modules/
jspm_packages/
dist/
build/
.next/
out/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo
.vite/
frontend/dist/
frontend/node_modules/

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── IDE & OS Files ───────────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── AI Tools & Temporary Storage ────────────────────────────────────────────
.gemini/
.claude/
.agents/
tmp/
temp/
